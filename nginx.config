## Skilled ERP — Nginx
##
## Este servidor opera en modo API-only. El frontend (React) vive en Vercel;
## este host solo expone:
##   - /api/*        → Flask via Gunicorn (autenticado con JWT)
##   - /uploads/*    → archivos subidos por usuarios (fotos, documentos)
##   - /static/*     → estáticos legacy (se mantienen mientras se completa la
##                     limpieza de templates Jinja apagados con LEGACY_UI_ENABLED=false)
##   - /             → 200 con info del servicio (definido en app/__init__.py)
##   - /health       → check para Cloudflare Tunnel / Render / etc.
##
## CORS: se gestiona EN FLASK (flask_cors) leyendo CORS_ORIGINS del .env.
## NO duplicar headers Access-Control-* aquí — provoca duplicados que rompen
## el navegador con "header appears more than once".

# ── Rate limit zonas ─────────────────────────────────────────────────────────
# Segunda línea de defensa además de Flask-Limiter. Crucial para endpoints
# anónimos (auth/login, auth/refresh) y para limitar abuso del bypass de origin
# si alguien encuentra la IP real del servidor.
#
# Nota: estas directivas deben vivir en el contexto `http {}`. Algunos setups
# de nginx incluyen sites-available DENTRO de http {} (Debian/Ubuntu por
# defecto), por lo que funcionan aquí. Si tu nginx incluye este archivo a
# nivel server (rare), mueve estas dos líneas a `/etc/nginx/conf.d/limits.conf`
# o al `http {}` de `/etc/nginx/nginx.conf`.
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_auth:10m rate=30r/m;

# Header Connection vacío para upstream (anti HTTP request smuggling).
# Por defecto nginx propaga el header Connection del cliente al upstream, lo
# que abre vectores tipo CL.TE/TE.CL smuggling y CVE históricos. Forzando
# Connection: "" en proxy_set_header nginx maneja el keep-alive con upstream
# independientemente. Esto es preferible a `Connection "upgrade"` cuando NO
# usas WebSockets (este servicio es API JSON puro).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── Server principal ─────────────────────────────────────────────────────────
server {
    listen 127.0.0.1:80 default_server;
    # server_name específico: si en algún momento usas múltiples vhost en el
    # mismo nginx, cámbialo a `api.skilled.com.mx` y deja un server vacío con
    # `default_server` para devolver 444 a Host headers desconocidos.
    server_name _;

    # No revelar versión de nginx en headers / páginas de error
    server_tokens off;

    # ── Timeouts anti-Slowloris ──────────────────────────────────────────────
    # Defaults de nginx son generosos (60s headers, 60s body). Bajarlos cierra
    # ataques de envío lento que mantienen workers ocupados con bytes goteando.
    client_header_timeout 10s;
    client_body_timeout   30s;
    send_timeout          30s;
    keepalive_timeout     30s;
    reset_timedout_connection on;

    # Body upload (5 MB para JSON / forms normales; los uploads de imagen y
    # documentos se controlan por location específico abajo).
    client_max_body_size      50M;
    client_body_buffer_size   128k;

    # Headers de seguridad: una sola fuente de verdad → Flask (app/__init__.py).
    # Solo dejamos X-Content-Type-Options como defensa de respaldo para errores
    # tempranos del WSGI que pudieran saltarse el after_request de Flask. El
    # flag `always` asegura que también aplique a respuestas 4xx/5xx.
    add_header X-Content-Type-Options "nosniff" always;

    # Oculta headers que revelan el stack (`Server: gunicorn/X.Y` y
    # `X-Powered-By: Flask/X.Y.Z`). nginx propaga estos del upstream por
    # defecto — esto los borra de la respuesta final al cliente.
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    # ── IPs reales de Cloudflare ─────────────────────────────────────────────
    # Tomamos la IP de CF-Connecting-IP SOLO cuando la conexión TCP viene de
    # un rango oficial de Cloudflare. Actualizar de https://www.cloudflare.com/ips/
    # (la app también las refresca al arranque vía extensions._load_cloudflare_cidrs).
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;
    # real_ip_recursive on: si hay varios IPs en X-Forwarded-For, descartar
    # las del set_real_ip_from para quedarse con la última no-trusted (la real).
    real_ip_recursive on;

    # ── Compresión ───────────────────────────────────────────────────────────
    # Aplica a respuestas JSON (efectivo para listas grandes como
    # /api/trabajadores y reportes paginados).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        application/json
        application/javascript
        text/css
        text/plain
        image/svg+xml;
    gzip_min_length 256;

    # ── Bloque proxy compartido ──────────────────────────────────────────────
    # Headers que TODOS los location blocks que hacen proxy_pass deben mandar.
    # Antes faltaban en /api/auth/* y / — el resultado era que
    # get_real_client_ip_flask() veía 127.0.0.1, el lockout escalado no
    # contaba bien por IP, y request.is_secure devolvía False (cookie sin Secure).
    # Definir un solo include resolvió la duplicación.
    #
    # Si prefieres archivo aparte, mueve esto a /etc/nginx/snippets/proxy_api.conf
    # y reemplaza el `# === [proxy_common] ===` por `include snippets/proxy_api.conf;`

    # ── Static legacy (solo necesario si LEGACY_UI_ENABLED=true) ─────────────
    # Si la migración al SPA ya cerró 100%, borra este bloque para reducir
    # superficie.
    location /static/ {
        alias /opt/nominas/static/;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # ── Uploads (fotos, documentos de empleados) ─────────────────────────────
    # Servidos directamente por nginx para descargar a Gunicorn de servir
    # binarios grandes. La autorización se hace antes vía Flask cuando es
    # necesario (ver bloque /x-accel-uploads/).
    #
    # MED-11 hardening: CSP "default-src 'none'" bloquea ejecución de scripts
    # inline si por algún bypass del magic-byte check entrara un HTML/SVG
    # malicioso disfrazado de imagen. CORP same-site evita hot-linking desde
    # otros dominios.
    location /uploads/ {
        alias /opt/nominas/uploads/;
        expires 7d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'" always;
        add_header Cross-Origin-Resource-Policy "same-site" always;
        # Las fotos las renderiza el SPA con <img src=...>, no forzamos attachment.
        access_log off;
    }

    # ── X-Accel-Redirect ─────────────────────────────────────────────────────
    # Flask devuelve el header X-Accel-Redirect (cuando USE_X_ACCEL_REDIRECT=true)
    # para que nginx sirva el archivo internamente sin que el usuario vea su path
    # real. Útil para documentos privados donde Flask valida permisos pero nginx
    # entrega el byte.
    location /x-accel-uploads/ {
        internal;
        alias /opt/nominas/uploads/;
        expires 7d;
        add_header Cache-Control "private, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ── Endpoints de autenticación (rate-limit estricto) ─────────────────────
    # 10 r/m por IP. Burst=5 permite que el SPA haga el flow legítimo
    # (login + verify-2fa + refresh) sin trabarse. Estos endpoints son los
    # principales objetivos de brute-force.
    location ~ ^/api/auth/(login|verify-2fa|refresh) {
        limit_req zone=api_auth burst=30 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;
        # Conexión cerrada por request (no keep-alive en endpoints sensibles).
        proxy_set_header Connection        "";

        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_connect_timeout 5s;

        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # ── Socket.IO (handshake polling + upgrade a WebSocket) ──────────────────
    # DEBE ir antes de `location /` para tener prioridad. Característico:
    #   - Sí propagamos Upgrade/Connection (a diferencia de /api/ que los
    #     anula por anti-smuggling): es lo que permite el upgrade a WS.
    #     El map `$connection_upgrade` (línea 35) ya devuelve "upgrade" o
    #     "close" según haya o no Upgrade header, así que sigue siendo seguro
    #     para requests no-WS (long-poll).
    #   - proxy_read_timeout 3600s: las conexiones WS viven horas. Con el
    #     default de 60s, el socket se cae cada minuto.
    #   - proxy_buffering off: long-poll y WS deben fluir en tiempo real;
    #     con buffering activo nginx acumula chunks y rompe la entrega.
    location /socket.io/ {
        limit_req zone=api_general burst=300 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 5s;

        proxy_buffering off;

        add_header Cache-Control "no-store" always;
    }

    # ── API JSON (rate-limit moderado) ───────────────────────────────────────
    # 60 r/m por IP, burst=20. Sin cache (cada respuesta es contexto-sensitiva
    # al JWT del usuario).
    location /api/ {
        limit_req zone=api_general burst=300 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;
        # Connection "": evita HTTP request smuggling al no propagar el header
        # Connection del cliente al upstream. Antes era `Connection "upgrade"`
        # más el header `Upgrade $http_upgrade`, pero esta app NO usa WebSockets
        # (es JSON puro). Mantenerlo abre vectores de smuggling sin beneficio.
        proxy_set_header Connection        "";

        # 120s aguanta exports de Excel grandes y PDFs de prenómina con muchos
        # trabajadores. Si los reportes crecen, subir aquí + en gunicorn.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 5s;

        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # ── Health + root JSON ───────────────────────────────────────────────────
    # Mismas razones que /api/ pero timeout más corto. Health check de
    # Cloudflare Tunnel pega aquí.
    location / {
        limit_req zone=api_general burst=300 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";

        proxy_read_timeout    30s;
        proxy_send_timeout    30s;
        proxy_connect_timeout 5s;

        add_header Cache-Control "no-store, no-cache" always;
    }

    # ── Bloquear requests con métodos HTTP raros ─────────────────────────────
    # Solo aceptamos los métodos que la API usa. Esto bloquea TRACE/TRACK
    # (XST attacks), CONNECT, PROPFIND, etc.
    if ($request_method !~ ^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)$) {
        return 405;
    }

    # ── Bloquear paths comúnmente escaneados (anti-noise en logs) ────────────
    # Devuelve 404 inmediato sin consumir un worker de Flask.
    location ~* \.(env|git|sql|bak|swp|log)$ { return 404; access_log off; }
    location ~* /\.(env|git|svn|htpasswd|htaccess) { return 404; access_log off; }
    location = /wp-login.php { return 404; access_log off; }
    location = /wp-admin     { return 404; access_log off; }
    location = /xmlrpc.php   { return 404; access_log off; }
    location = /phpmyadmin   { return 404; access_log off; }
}
