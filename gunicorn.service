[Unit]
Description=Sistema de Nominas - Gunicorn (Flask API)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
User=sistemanominas
Group=www-data
WorkingDirectory=/opt/nominas
Environment="PATH=/opt/nominas/venv/bin"

# IMPORTANTE — permisos del .env:
#   sudo chown root:sistemanominas /opt/nominas/.env
#   sudo chmod 640 /opt/nominas/.env
# Contiene SECRET_KEY, DATABASE_URL, TOTP_ENCRYPTION_KEY, MAIL_PASSWORD,
# GROQ_API_KEY. Solo el user del servicio debe poder leerlo.
EnvironmentFile=/opt/nominas/.env

# Modo API-only para el SPA en Vercel. WebSockets habilitados vía gthread.
#
# Worker class: gthread
#   Intentamos eventlet inicialmente pero psycopg3 lo rompe al boot — el
#   monkey_patch() de eventlet 0.36+ reemplaza queue.Queue con la verde, que
#   no implementa __class_getitem__; psycopg3 hace `class Queue(queue.Queue[T])`
#   y truena con `TypeError: type 'Queue' is not subscriptable`. Ver
#   docs/MIGRACION_EVENTLET_A_GEVENT.md.
#
#   gthread no necesita monkey-patching y convive con psycopg3 sin problemas.
#   Para Socket.IO usamos async_mode='threading' (no requiere libs externas).
#
# Workers: 4 + Threads: 6
#   Dimensionado para Lenovo ThinkCentre Tiny (i5 6ta gen = 4 cores/4 threads,
#   8 GB RAM compartidos con Postgres + Redis + nginx + SO).
#   4 procesos = 1 por core físico. 6 threads/worker = sweet spot del GIL para
#   gthread (más allá de ~8 la contención degrada throughput sin sumar
#   capacidad). Total: 24 conexiones simultáneas. Cada cliente Socket.IO ocupa
#   un thread (long-poll/WS), así que el techo realista de realtime es
#   ~20-22 usuarios concurrentes dejando margen para REST.
#
#   Memoria estimada: 4 × ~200 MB = ~800 MB en workers, dejando ~3 GB para
#   shared_buffers de Postgres tras OS + Redis. NO subir workers a 6+ sin
#   ampliar RAM a 16 GB — Postgres se queda sin cache y entra a swap.
#
#   Si llegamos al techo de WS, el paso correcto es gevent + psycogreen (ver
#   doc de migración) NO eventlet — pero antes valida que CPU/RAM aguanten,
#   gevent no inventa cores.
#
# Timeout 120s: aguanta exports de Excel grandes y PDFs consolidados de
# prenómina con muchos trabajadores. Subir aquí Y en nginx (proxy_read_timeout)
# si los reportes empiezan a tronar por timeout.
#
# --worker-tmp-dir /dev/shm: RAM en vez de disco para los heartbeats master/worker.
#
# --forwarded-allow-ips=127.0.0.1: solo confía en X-Forwarded-* desde nginx local.
#
# --max-requests + --max-requests-jitter: reinicio tras ~1000±100 requests
# (mitiga memory leaks de pandas/openpyxl/xhtml2pdf en exports grandes).
#
# --limit-request-*: defaults son altos; los acotamos contra HTTP bomb DoS.
#
# Logs a stdout/stderr → journald los captura (`journalctl -u gunicorn`).
ExecStart=/opt/nominas/venv/bin/gunicorn \
    --workers 4 \
    --worker-class gthread \
    --threads 6 \
    --worker-tmp-dir /dev/shm \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --limit-request-line 4094 \
    --limit-request-fields 32 \
    --limit-request-field_size 8190 \
    --forwarded-allow-ips=127.0.0.1 \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    run:app

# Reload graceful (SIGHUP). systemctl reload no mata workers en mitad de un PDF.
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy: si crashea, reinicia. Pero si crashea 5 veces en 60s,
# detente y avisa — evita restart-storm que oculta bugs reales.
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# ── Hardening systemd ────────────────────────────────────────────────────────
# Cada directiva restringe una superficie distinta. El servicio funciona
# correctamente con todo esto activado — son defensas en profundidad por si
# una RCE en Flask/SQLAlchemy/openpyxl da shell al atacante.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute: bloquea JIT (PyPy, ctypes con código generado).
# CPython estándar funciona, pero si en el futuro agregas una dep con JIT,
# desactiva esta línea.
MemoryDenyWriteExecute=yes

# Capabilities: el servicio no necesita ninguna (no escucha puertos privilegiados,
# bind a 127.0.0.1:8000 es no-privileged).
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: solo lectura excepto los paths declarados. /tmp es privado al unit
# por PrivateTmp=yes, no necesita declararse aquí.
ReadWritePaths=/opt/nominas/uploads /opt/nominas/data

# Limites de recursos: previenen runaway processes (memory bomb, fork bomb).
# Valores dimensionados para Lenovo Tiny i5 6ta / 8 GB RAM con la config
# 4 workers × 6 threads. NOFILE 8192 cubre con holgura: cada conexión HTTP/WS
# consume 1 fd, más fds de sockets a Postgres/Redis y archivos abiertos en
# exports. NPROC 512 deja margen para threads + procesos hijos de subprocess
# (xhtml2pdf, pandas) sin permitir un fork-bomb.
LimitNOFILE=8192
LimitNPROC=512

# Variables de entorno extra (defensa para que las libs no escriban en home)
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PIP_DISABLE_PIP_VERSION_CHECK=1"

# Socket.IO: usa primitivas async de threading (coincide con --worker-class
# gthread). En dev (sin esta variable) la app cae igual a 'threading' y usa
# `socketio.run` con Werkzeug — el comportamiento es idéntico entre dev y prod
# en este aspecto.
Environment="SOCKETIO_ASYNC_MODE=threading"

[Install]
WantedBy=multi-user.target
