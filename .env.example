# ─────────────────────────────────────────────────────────────────────────────
# Skilled ERP — Backend Flask
#
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` está en .gitignore — nunca lo commitees.
# ─────────────────────────────────────────────────────────────────────────────


# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py

# 'development' habilita modo debug y desactiva STS en headers.
# 'production' en el servidor real.
FLASK_ENV=development


# ── Seguridad (CRÍTICOS) ─────────────────────────────────────────────────────
# Llave maestra de Flask (sesiones, CSRF, firmas).
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
# La app NO arranca sin esta variable.
SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria

# Clave Fernet para cifrar los secretos TOTP de 2FA en la base de datos.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=cambiar_por_una_clave_fernet


# ── Base de datos ────────────────────────────────────────────────────────────
# Producción: PostgreSQL.
# Local: puedes dejar el default (sqlite:///app.db) para pruebas rápidas.
DATABASE_URL=postgresql+psycopg://tu_usuario:tu_contrasena@localhost:5432/nombre_base_de_datos

# Tamaño del pool de conexiones por worker (solo PostgreSQL). Default 10+10.
# IMPORTANTE: el total de conexiones es  workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Con 4 workers y 10+10 = 80 conexiones; mantenlo por debajo del max_connections
# de Postgres (default 100). Si subes estos valores, sube también max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10


# ── Redis (rate limiting + cache) ────────────────────────────────────────────
# Si no se setea, Flask-Limiter cae a almacenamiento en memoria (no apto para prod).
REDIS_URL=redis://localhost:6379/0


# ── Correo (recibos de prenómina, alertas) ──────────────────────────────────
# Para Gmail: generar un App Password en https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail


# ── CORS / Frontend ──────────────────────────────────────────────────────────
# Orígenes permitidos para llamar a /api/* (separados por coma, sin slash final).
# Dev local: el puerto de Vite es 5173.
# Producción: los dominios reales del SPA en Vercel.
#
# Ejemplo prod:
#   CORS_ORIGINS=https://skilled.vercel.app,https://app.skilled.com.mx
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── Socket.IO / WebSockets ──────────────────────────────────────────────────
# Motor async que usa Flask-SocketIO en el server.
#   'threading' → dev local (Werkzeug `socketio.run`). Default si no se setea.
#   'gevent'    → prod. Coincide con `--worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker`
#                 en gunicorn (ver gunicorn.serviceee y docs/DEPLOY_GEVENT.md).
#                 Requiere gevent + gevent-websocket + psycogreen, y monkey_patch
#                 + patch_psycopg() aplicados al inicio de run.py.
#   'eventlet'  → NO USAR. Incompatible con psycopg3 (no arranca contra Postgres).
SOCKETIO_ASYNC_MODE=threading


# ── Refresh-token cookie ─────────────────────────────────────────────────────
# SameSite del cookie del refresh token:
#   'Lax'  → frontend y API en el mismo sitio (default).
#   'None' → cross-site (p.ej. SPA en Vercel + API en otro dominio).
#            Cuando se usa 'None', el cookie automáticamente se marca Secure=True
#            (lo exige el navegador), por lo que requiere HTTPS.
RT_COOKIE_SAMESITE=Lax


# ── Producción: optimizaciones de Nginx ──────────────────────────────────────
# Activa el header X-Accel-Redirect para que Nginx sirva las fotos de perfil
# directamente desde disco (~20ms vs ~600ms). Requiere el location
# /x-accel-uploads/ configurado en nginx (ver nginx.config).
USE_X_ACCEL_REDIRECT=false

# HSTS preload: anuncia a los browsers que metan tu dominio en su lista de
# HTTPS-only. ES SEMI-IRREVERSIBLE (sacarlo lleva semanas/meses), no actives
# hasta estar 100% seguro de tu setup HTTPS.
HSTS_PRELOAD=false


# ── Cloudflare R2 (imágenes de productos → WebP) ─────────────────────────────
# Almacena las imágenes del catálogo en Cloudflare R2 (S3-compatible), ya
# convertidas a WebP. Cómo obtener cada valor:
#   1. dash.cloudflare.com → R2 → Create bucket (ej. skilled-productos).
#   2. Bucket → Settings → Public access → Connect Domain (ej. img.tudominio.com)
#      → ese dominio es R2_PUBLIC_BASE_URL.
#   3. R2 → Overview → copia el Account ID (R2_ACCOUNT_ID).
#   4. R2 → Manage R2 API Tokens → Create (Object Read & Write) → copia
#      Access Key ID y Secret Access Key (se muestran UNA sola vez).
# Si estas variables quedan VACÍAS, el pipeline se desactiva solo: el catálogo
# sigue funcionando guardando la URL de imagen tal cual (comportamiento actual).
R2_ACCOUNT_ID=
R2_BUCKET=skilled-productos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://img.tudominio.com
# true solo para forzar el pipeline fuera de producción (pruebas). En prod no hace falta.
R2_FORCE_ENABLE=false


# ── Cloudflare R2 PRIVADO (fotos de perfil, documentos, evidencias) ──────────
# Bucket SEPARADO y SIN dominio público: acá viven documentos de RRHH con PII
# (contratos, INE, CURP), fotos de personal y evidencias de herramientas. El
# acceso sigue siendo por los endpoints con JWT — NO conectes un dominio público
# a este bucket.
#   1. dash.cloudflare.com → R2 → Create bucket (ej. skilled-privados).
#      NO le conectes dominio ni actives "Allow public access".
#   2. Solo con R2_PRIVADO_BUCKET basta si el token de R2_* del mismo entorno ya
#      puede escribir en ese bucket. Si prefieres un token dedicado (más
#      estricto), llena también ACCESS_KEY_ID / SECRET_ACCESS_KEY / ACCOUNT_ID.
# Si R2_PRIVADO_BUCKET queda VACÍA, todo se guarda en disco como hasta hoy.
# OJO: las llaves cambian por entorno — local y el VPS llevan valores distintos.
R2_PRIVADO_BUCKET=
# Opcionales: si van vacías, se reusan las R2_* de arriba (mismo entorno).
R2_PRIVADO_ACCOUNT_ID=
R2_PRIVADO_ACCESS_KEY_ID=
R2_PRIVADO_SECRET_ACCESS_KEY=


# ── Antivirus (ClamAV) para documentos subidos ───────────────────────────────
# Solo aplica a los PDF de trabajadores: todo lo que es imagen ya se re-encodea
# a WebP, y ese re-render destruye cualquier payload embebido. El PDF se guarda
# intacto, así que es el único que necesita mirar el CONTENIDO.
# Si ambas quedan VACÍAS el antivirus está apagado y las subidas funcionan
# exactamente como hasta hoy. Instalación: docs/ANTIVIRUS_CLAMAV.md
# OJO: clamd necesita ~1.5 GB de RAM para las firmas. Revisa que el VPS aguante.
#
# DÉJALA VACÍA hasta tener clamd instalado y corriendo. Si la llenas antes, el
# antivirus queda "encendido" apuntando a un socket que no existe y —con
# CLAMAV_FAIL_CLOSED=true— toda subida de PDF responderá 503.
# Valor típico una vez instalado: /var/run/clamav/clamd.ctl
CLAMAV_SOCKET=
# Alternativa si clamd corre en otra máquina (deja CLAMAV_SOCKET vacío):
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
# true (por defecto): si clamd no responde, la subida se RECHAZA con 503. Un
# archivo que nadie revisó no debería pasar por bueno en silencio. Ponlo en
# false solo si prefieres que se pueda seguir subiendo con el antivirus caído.
CLAMAV_FAIL_CLOSED=true
# Límite de tamaño (bytes = 10 MB) y timeout (segundos) al descargar imágenes externas.
IMG_MAX_DOWNLOAD_BYTES=10485760
IMG_FETCH_TIMEOUT=10
# Anti-bomba de descompresión: máx. píxeles (ancho×alto) de la imagen. 50 MP.
IMG_MAX_PIXELS=50000000
# Tope de imágenes por corrida de "Sincronizar" (el resto queda para la próxima).
IMG_SYNC_MAX_POR_CORRIDA=2000
