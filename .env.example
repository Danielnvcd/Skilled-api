# ─────────────────────────────────────────────────────────────────────────────
# Skilled ERP — Backend Flask
#
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` está en .gitignore — nunca lo commitees.
# ─────────────────────────────────────────────────────────────────────────────


# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py

# 'development' habilita modo debug y desactiva STS en headers.
# 'production' en el servidor real.
FLASK_ENV=development


# ── Seguridad (CRÍTICOS) ─────────────────────────────────────────────────────
# Llave maestra de Flask (sesiones, CSRF, firmas).
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
# La app NO arranca sin esta variable.
SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria

# Clave Fernet para cifrar los secretos TOTP de 2FA en la base de datos.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=cambiar_por_una_clave_fernet


# ── Base de datos ────────────────────────────────────────────────────────────
# Producción: PostgreSQL.
# Local: puedes dejar el default (sqlite:///app.db) para pruebas rápidas.
DATABASE_URL=postgresql+psycopg://tu_usuario:tu_contrasena@localhost:5432/nombre_base_de_datos


# ── Redis (rate limiting + cache) ────────────────────────────────────────────
# Si no se setea, Flask-Limiter cae a almacenamiento en memoria (no apto para prod).
REDIS_URL=redis://localhost:6379/0


# ── Correo (recibos de prenómina, alertas) ──────────────────────────────────
# Para Gmail: generar un App Password en https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail


# ── CORS / Frontend ──────────────────────────────────────────────────────────
# Orígenes permitidos para llamar a /api/* (separados por coma, sin slash final).
# Dev local: el puerto de Vite es 5173.
# Producción: los dominios reales del SPA en Vercel.
#
# Ejemplo prod:
#   CORS_ORIGINS=https://skilled.vercel.app,https://app.skilled.com.mx
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── Socket.IO / WebSockets ──────────────────────────────────────────────────
# Motor async que usa Flask-SocketIO en el server.
#   'threading' → dev local (Werkzeug `socketio.run`). Default si no se setea.
#   'gevent'    → prod. Coincide con `--worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker`
#                 en gunicorn (ver gunicorn.serviceee y docs/DEPLOY_GEVENT.md).
#                 Requiere gevent + gevent-websocket + psycogreen, y monkey_patch
#                 + patch_psycopg() aplicados al inicio de run.py.
#   'eventlet'  → NO USAR. Incompatible con psycopg3 (no arranca contra Postgres).
SOCKETIO_ASYNC_MODE=threading


# ── Refresh-token cookie ─────────────────────────────────────────────────────
# SameSite del cookie del refresh token:
#   'Lax'  → frontend y API en el mismo sitio (default).
#   'None' → cross-site (p.ej. SPA en Vercel + API en otro dominio).
#            Cuando se usa 'None', el cookie automáticamente se marca Secure=True
#            (lo exige el navegador), por lo que requiere HTTPS.
RT_COOKIE_SAMESITE=Lax


# ── Producción: optimizaciones de Nginx ──────────────────────────────────────
# Activa el header X-Accel-Redirect para que Nginx sirva las fotos de perfil
# directamente desde disco (~20ms vs ~600ms). Requiere el location
# /x-accel-uploads/ configurado en nginx (ver nginx.config).
USE_X_ACCEL_REDIRECT=false

# HSTS preload: anuncia a los browsers que metan tu dominio en su lista de
# HTTPS-only. ES SEMI-IRREVERSIBLE (sacarlo lleva semanas/meses), no actives
# hasta estar 100% seguro de tu setup HTTPS.
HSTS_PRELOAD=false
