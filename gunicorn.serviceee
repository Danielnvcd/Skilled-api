[Unit]
Description=Sistema de Nominas - Gunicorn (Flask API)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
User=sistemanominas
Group=www-data
WorkingDirectory=/opt/nominas
Environment="PATH=/opt/nominas/venv/bin"

# IMPORTANTE — permisos del .env:
#   sudo chown root:sistemanominas /opt/nominas/.env
#   sudo chmod 640 /opt/nominas/.env
# Contiene SECRET_KEY, DATABASE_URL, TOTP_ENCRYPTION_KEY, MAIL_PASSWORD,
# GROQ_API_KEY. Solo el user del servicio debe poder leerlo.
EnvironmentFile=/opt/nominas/.env

# Modo API-only para el SPA en Vercel. WebSockets habilitados vía gevent.
#
# Worker class: geventwebsocket.gunicorn.workers.GeventWebSocketWorker
#   gthread (anterior) NO soporta el upgrade WebSocket — acepta el GET pero
#   no implementa el cambio de protocolo, así que el SPA cae en loop de
#   reconexión. eventlet no es opción: su monkey_patch reemplaza queue.Queue
#   y rompe psycopg3 al boot.
#
#   gevent SÍ funciona: monkey-patch en run.py (gateado por SOCKETIO_ASYNC_MODE),
#   y psycopg3 >=3.1.14 lo soporta nativamente sin necesidad de psycogreen
#   (psycogreen es psycopg2-only y no aplica aquí). Ver
#   docs/MIGRACION_EVENTLET_A_GEVENT.md.
#
# Workers: 4 + worker-connections: 1000
#   Dimensionado para Lenovo ThinkCentre Tiny (i5 6ta gen = 4 cores/4 threads,
#   8 GB RAM compartidos con Postgres + Redis + nginx + SO).
#   4 procesos = 1 por core físico. Con gevent cada worker maneja miles de
#   conexiones concurrentes vía greenlets cooperativos (no hay GIL contention
#   como gthread). worker-connections=1000 es el máximo de greenlets por worker.
#
#   Memoria estimada: 4 × ~200 MB = ~800 MB en workers, dejando ~3 GB para
#   shared_buffers de Postgres tras OS + Redis. NO subir workers a 6+ sin
#   ampliar RAM a 16 GB — Postgres se queda sin cache y entra a swap.
#
#   CONEXIONES A POSTGRES: cada worker abre su propio pool SQLAlchemy. El total es
#       workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#   Con 4 workers y los defaults 10+10 (ver más abajo) = 80 conexiones. El
#   max_connections de Postgres (default 100, menos 3 superuser_reserved) deja
#   ~17 libres para psql/backups. Esta es la SEGUNDA razón para no subir a 6
#   workers: 6 × 20 = 120 > 100 → la app se quedaría sin conexiones. Si subes
#   workers o el pool, sube también max_connections en postgresql.conf.
#
#   Trade-off de gevent vs gthread: gevent gana en concurrencia I/O (WS, REST
#   con DB) pero un export pesado (PDF, Excel grande) bloquea el worker entero
#   mientras dura. Si los exports empiezan a degradar latencia, considerar
#   subir workers a 6 o mover exports a un worker dedicado.
#
# Timeout 120s: aguanta exports de Excel grandes y PDFs consolidados de
# prenómina con muchos trabajadores. Subir aquí Y en nginx (proxy_read_timeout)
# si los reportes empiezan a tronar por timeout.
#
# --worker-tmp-dir /dev/shm: RAM en vez de disco para los heartbeats master/worker.
#
# --forwarded-allow-ips=127.0.0.1: solo confía en X-Forwarded-* desde nginx local.
#
# --access-logformat: el default usa %(h)s = peer address, que aquí siempre es
# 127.0.0.1 porque la conexión viene de nginx local. Sustituimos por el header
# X-Real-IP que nginx setea con la IP real del cliente (después del unwrap de
# CF-Connecting-IP via set_real_ip_from en nginx.config). %(L)s al final
# imprime el tiempo de request en segundos — útil para detectar endpoints lentos
# sin tener que mirar logs de nginx también.
#
# --max-requests + --max-requests-jitter: reinicio tras ~1000±100 requests
# (mitiga memory leaks de pandas/openpyxl/xhtml2pdf en exports grandes).
#
# --limit-request-*: defaults son altos; los acotamos contra HTTP bomb DoS.
#
# Logs a stdout/stderr → journald los captura. El unit desplegado se llama
# `nominas.service`, así que se consulta con `journalctl -u nominas -f`.
ExecStart=/opt/nominas/venv/bin/gunicorn \
    --workers 4 \
    --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker \
    --worker-connections 1000 \
    --worker-tmp-dir /dev/shm \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --graceful-timeout 60 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --limit-request-line 4094 \
    --limit-request-fields 32 \
    --limit-request-field_size 8190 \
    --forwarded-allow-ips=127.0.0.1 \
    --access-logfile - \
    --access-logformat='%({x-real-ip}i)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s" %(L)s' \
    --error-logfile - \
    --capture-output \
    run:app

# Reload graceful (SIGHUP). systemctl reload no mata workers en mitad de un PDF.
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy: si crashea, reinicia. Pero si crashea 5 veces en 60s,
# detente y avisa — evita restart-storm que oculta bugs reales.
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# ── Hardening systemd ────────────────────────────────────────────────────────
# Cada directiva restringe una superficie distinta. El servicio funciona
# correctamente con todo esto activado — son defensas en profundidad por si
# una RCE en Flask/SQLAlchemy/openpyxl da shell al atacante.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute: bloquea JIT (PyPy, ctypes con código generado).
# CPython estándar funciona. Con gevent: greenlet usa mmap para stacks y en
# algunas plataformas/glibc puede requerir W+X. Si al boot ves
# "PermissionError" o gunicorn no arranca tras migrar a gevent, comenta esta
# línea (la pérdida de hardening es aceptable a cambio de WebSocket funcional).
MemoryDenyWriteExecute=yes

# Capabilities: el servicio no necesita ninguna (no escucha puertos privilegiados,
# bind a 127.0.0.1:8000 es no-privileged).
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: solo lectura excepto los paths declarados. /tmp es privado al unit
# por PrivateTmp=yes, no necesita declararse aquí.
ReadWritePaths=/opt/nominas/uploads /opt/nominas/data

# Limites de recursos: previenen runaway processes (memory bomb, fork bomb).
# Valores dimensionados para Lenovo Tiny i5 6ta / 8 GB RAM con la config
# 4 workers gevent × hasta 1000 greenlets c/u (NO threads — gevent es
# concurrencia cooperativa monohilo). NOFILE 8192 cubre con holgura: cada
# conexión HTTP/WS consume 1 fd, más fds de sockets a Postgres/Redis y archivos
# abiertos en exports. NPROC 512 deja margen para los procesos hijos de
# subprocess (xhtml2pdf, pandas) sin permitir un fork-bomb.
LimitNOFILE=8192
LimitNPROC=512

# Variables de entorno extra (defensa para que las libs no escriban en home)
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PIP_DISABLE_PIP_VERSION_CHECK=1"

# Socket.IO async_mode=gevent: coincide con --worker-class gevent y permite
# manejar WebSocket real (upgrade HTTP→WS). También dispara el monkey-patching
# en run.py (la cabecera del archivo gatea `monkey.patch_all()` con esta var).
# En dev local sin esta variable, run.py NO parchea y socketio.run usa Werkzeug.
Environment="SOCKETIO_ASYNC_MODE=gevent"

# Pool de conexiones a Postgres (lo lee app/__init__.py). NO se declaran aquí
# con Environment= a propósito: van en /opt/nominas/.env para poder ajustarlos
# sin editar el unit (y porque Environment= sobreescribiría al EnvironmentFile).
# Defaults del código si no se setean: DB_POOL_SIZE=10, DB_MAX_OVERFLOW=10.
# Recordatorio: workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW) ≤ max_connections.

[Install]
WantedBy=multi-user.target
